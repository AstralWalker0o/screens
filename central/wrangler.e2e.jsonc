{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "screens-e2e",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "screens", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "screens-store" }],
  "durable_objects": { "bindings": [{ "name": "SITE_HUB", "class_name": "SiteHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteHub"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DOT_BASE_DOMAIN": "dns.screens.supercluster.au",
    // App update sources talk to the stand-in GitHub that tools/e2e/e2e.py serves, never to api.github.com.
    "GITHUB_API_BASE": "http://127.0.0.1:8791"
  },
  "observability": { "enabled": true }
}
